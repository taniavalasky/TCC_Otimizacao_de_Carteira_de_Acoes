    /* Fundo escurecido */
  #alertOverlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
    z-index: 1000;
  }

  /* Caixa do alerta */
  #alertBox {
    background: white;
    border-radius: 12px;
    padding: 25px 35px;
    max-width: 400px;
    text-align: center;
    font-family: "Lora", serif;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    animation: pop 0.2s ease-in-out;
  }

  /* Animação de entrada */
  @keyframes pop {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  /* Botão OK */
  #alertBox button {
    margin-top: 20px;
    padding: 8px 20px;
    background-color: #0056b3;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 15px;
  }

  #alertBox button:hover {
    background-color: #003f7f;
  }

    #alertBox button.secondary {
    background-color: #6c757d;
  }

  #alertBox button.secondary:hover {
    background-color: #555;
  }

