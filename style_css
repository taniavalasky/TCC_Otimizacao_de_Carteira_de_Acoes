@import url("https://fonts.googleapis.com/css2?family=League+Gothic:wght@400&display=swap");
@import url("https://fonts.googleapis.com/css2?family=Lora:wght@400;500;700&display=swap");
@import url("https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap");

body {
  background-color: #e8f3fd; /* exemplo: azul claro */
  font-family: "League Gothic", sans-serif;
  margin: 50px;
}

a {
  background: #c3e0fc;
  color: #000;
  padding: 15px;
  border-radius: 4px;
  text-decoration: none;
  border: 1px dotted #000; /* borda pontilhada */
  font-size: 25px;
}

.menu_lateral {
  position: fixed;
  top: 50px;
  left: 20px;
  display: flex;
  width: 220px;
  flex-direction: column;
  gap: 10px;
  z-index: 999;
}
 
img {
  max-width: 400px; /* limite máximo que a imagem pode ter */
  width: 100%; /* ocupa 100% da largura do contêiner, até o máximo */
  height: auto; /* mantém a proporção */
  border-radius: 4px;
  display: block;
  margin: 0 auto;
}

.imagem_container {
  max-width: 400px; /* limite máximo */
  width: 100%;
  margin: 0 auto;
}

.imagem_container img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 4px;
}

h2 {
  text-align: center;
  font-size: 40px;
  color: #000;
  margin-bottom: 40px;
}

.frase {
  text-align: center;
  color: #000000;
  font-size: 40px;
}

.item1 {
  background: #4169e1;
  color: #fff;
  padding: 5px;
  border-radius: 4px;
  display: grid;
}

.caixa {
  background: #c3e0fc;
  width: 100%; /* ocupa toda a largura possível */
  max-width: 780px; /* mas não passa de 780px */
  height: 100px;
  margin: 50px auto;
  padding: 40px;
  border-radius: 4px;
  box-sizing: border-box;
  border: 2px dotted #000;
  font-size: 40px;

  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #000;
}

.caixa_texto {
  background: #c3e0fc;
  width: 780px; /* largura exata que você quer */
  height: auto; /* altura exata que você quer */
  margin: 50px auto; /* 50px de margem acima e abaixo + centralizado */
  padding: 35px; /* espaço interno */
  border-radius: 4px;
  box-sizing: border-box; /* garante que padding conte dentro da largura/altura */
  border: 2px dotted #000; /* borda pontilhada */
  font-size: 40px;
}

.caixa_texto_grid {
  background: #c3e0fc;
  width: 100%; /* ocupa 100% da célula da grid */
  height: auto;
  padding: 35px;
  border-radius: 4px;
  box-sizing: border-box;
  border: 2px dotted #000;
  font-size: 40px;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr; /* duas colunas flexíveis */
  gap: 20px;
  justify-content: center;

  width: 100%; /* ocupa toda a largura possível */
  max-width: 780px; /* mas não ultrapassa 780px */
  margin: 0 auto; /* centraliza horizontalmente */
}

.grid_caixa {
  display: grid;
  grid-template-columns: 1fr 1fr; /* duas colunas de 370px */
  gap: 20px; /* espaço de 20px entre elas: 370 + 20 + 370 = 760px */
  justify-content: center;
  width: 780px; /* mesma largura da caixa_texto */
  margin: 0 auto; /* centralizar */
}

.titulo {
  text-align: center;
  font-size: 45px;
  color: #4169e1;
  margin-bottom: 40px;
}

.formulario {
  background-color: #ffffff;
  padding: 40px;
  border-radius: 4px;
  max-width: 700px;
  margin: 0 auto;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  border: 2px dotted #000; /* borda pontilhada */
  font-family: "Lora", sans-serif;
}

.pergunta {
  margin-bottom: 25px;
  font-size: 20px;
  color: #000;
}

.pergunta input {
  margin: 5px 10px 10px 0;
  transform: scale(1.2);
}

.negrito {
  font-family: "Lora", serif;
  font-weight: 700; /* ou 500 para menos intensidade */
}

.fontelora {
  font-family: "Lora", serif;
  font-size: 20px;
}
.fonteLeagueGothic {
  font-family: "League Gothic", sans-serif;
  font-size: 40px;
  text-align: center;
}

.fontelora_titulo {
  font-family: "Lora", serif;
  font-size: 20px;
  font-weight: 700;
  text-align: center;
}

.botao {
  background: #c3e0fc;
  color: #000;
  padding: 10px 100px; /*altura e largura*/
  font-size: 30px;
  font-family: "League Gothic", sans-serif;
  border: 2px dotted #000; /* borda pontilhada */
  border-radius: 4px;
  text-decoration: none;
  cursor: pointer;
  display: block;
  margin: 30px auto 0 auto;
  transition: background-color 0.3s;
}

