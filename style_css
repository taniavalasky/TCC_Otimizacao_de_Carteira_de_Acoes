/* Pop-up overlay */
.popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6); /* fundo escuro */
  display: none; /* começa invisível */
  justify-content: center;
  align-items: center;
  z-index: 999;
}

/* Caixa central */
.popup-content {
  background: #ffffff;
  padding: 40px;
  border-radius: 8px;
  border: 2px dotted #4169e1;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  max-width: 500px;
}

/* Botão dentro do popup (herda seu estilo atual) */
.popup .botao {
  margin-top: 20px;
}

/* para busca de açoes*/

.input_acao {
  width: 100%;
  padding: 10px;
  margin-top: 10px;
  font-size: 18px;
  border-radius: 4px;
  border: 1px solid #999;
  box-sizing: border-box;
  font-family: "Lora", serif;
}

.botao_busca {
  margin-top: 10px;
  padding: 10px 20px;
  background-color: #4169e1;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 18px;
  font-family: "Lora", serif;
}

.resultado {
  margin-top: 30px;
  background-color: #fff;
  border: 1px dashed #000;
  padding: 15px;
  border-radius: 4px;
  font-family: "Lora", serif;
  font-size: 18px;
}

.grafico {
  width: 100%;
  margin-top: 30px;
  height: 400px;
  background-color: #fff;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  border: 1px dashed #000;
  font-family: "Lora", serif;
  font-size: 10px;
  position: relative;
}

#mensagemGrafico {
    position: absolute;
    inset: 0;
    display: flex;
