.caixa_texto_recomendacao {
  background: #c3e0fc;
  width: 780px;              /* largura fixa */
  height: auto;              /* ajusta conforme o conteúdo */
  margin: 50px auto;         /* centraliza horizontalmente e dá espaço vertical */
  padding: 35px;
  border-radius: 4px;
  box-sizing: border-box;
  border: 2px dotted #000;
  font-size: 40px;

  /* --- Centralização --- */
  text-align: center;        /* centraliza o texto */
  display: flex;             /* permite centralizar vertical e horizontalmente */
  flex-direction: column;    /* mantém o conteúdo empilhado */
  align-items: center;       /* centraliza horizontalmente dentro do flex */
  justify-content: center;   /* centraliza verticalmente dentro do flex */
}

/* container dos dois botões */
.botoes_duplos {
  border: none !important;
  background: none !important;
  display: flex;             
  justify-content: center;   /* centraliza horizontalmente */
  align-items: center;       /* centraliza verticalmente dentro do espaço disponível */
  gap: 20px;                 
  margin: 40px auto;         /* 🔹 centraliza horizontalmente o container */
  width: fit-content;        /* 🔹 largura se ajusta aos botões */
}

/* estiliza os formulários que contêm os botões */
.form_botao {
  background: none;          
  border: none !important;   
  padding: 0;                
  margin: 0;                 
  box-shadow: none;          
  outline: none;             
}

/* botão dentro do form */
.form_botao button {
  background-color: #2c74b3;  
