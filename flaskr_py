@app.route('/salvar_carteira', methods=['POST'])
def salvar_carteira():
    """Salva a carteira sugerida na sessão."""
    session['carteira_salva'] = {
        'valor': request.form.get('valor'),
        'lucro': request.form.get('lucro'),
        'risco': request.form.get('risco'),
        'tabela': request.form.get('tabela')
    }
    flash('Carteira salva com sucesso!')
    return redirect(url_for('minha_carteira'))


@app.route('/minha_carteira')
def minha_carteira():
    """Mostra a carteira salva pelo usuário."""

    carteira_salva = session.get('carteira_salva')

    if not carteira_salva:
        flash('Nenhuma carteira salva ainda.')
        return redirect(url_for('recomendacoes'))

    # Converte o JSON armazenado na sessão em dicionário Python
    dados_tabela = json.loads(carteira_salva['tabela'])

    # Extrai a lista de ativos da carteira
    ativos = dados_tabela.get('ativos', [])

    return render_template(
        "janelas/minha_carteira.html",
        carteira=carteira_salva,
        ativos=ativos
    )

# ---------------- GRAFICO AÇÃO ----------------
@app.route("/grafico_acao/<ativo>")
def grafico_acao(ativo):
    try:
        # ----------------------------------------------------
        # Padroniza o código
        # ----------------------------------------------------
        ativo = ativo.upper().strip()
        if not ativo.endswith(".SA"):
            ativo += ".SA"

        # ----------------------------------------------------
        # Consulta o Yahoo Finance
        # ----------------------------------------------------

        ticker = yf.Ticker(
            ativo
        )

        # ----------------------------------------------------
        # Busca os últimos 12 meses
        #
        # period = 1y
        # interval = 1d
        #
        # Ou seja:
        # aproximadamente 1 ano de preços diários.
        # ----------------------------------------------------

        dados = ticker.history(
            period="1y",
            interval="1d",
            auto_adjust=False
        )

        # ----------------------------------------------------
        # Verifica se encontrou dados
        # ----------------------------------------------------

        if dados.empty:
            return {
                "erro":
                    f"Não foram encontrados dados para {ativo}."
            }, 404
        
        # ----------------------------------------------------
        # Seleciona somente o fechamento
        # ----------------------------------------------------
        precos = dados["Close"].dropna()
        # ----------------------------------------------------
        # Preparar datas
        # ----------------------------------------------------
        datas = [
            data.strftime("%d/%m/%Y")
            for data in precos.index
        ]
        # ----------------------------------------------------
        # Preparar preços
        # ----------------------------------------------------

        valores = [
            round(float(preco), 2)
            for preco in precos
        ]

        # ----------------------------------------------------
        # Retornar para o JavaScript
        # ----------------------------------------------------
        return {
            "ativo":
                ativo.replace(".SA", ""),
            "datas":
                datas,
            "precos":
                valores
        }

    except Exception as erro:
        print(
            f"Erro ao gerar gráfico de {ativo}:"
        )
        print(erro)
        return {
            "erro":
                "Erro ao consultar os dados da ação."
        }, 500

