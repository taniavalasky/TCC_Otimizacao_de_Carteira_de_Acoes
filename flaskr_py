@app.route('/recomendacoes', methods=['GET'])
def recomendacoes():
    """Exibe o formulário para gerar a carteira recomendada."""
    return render_template('janelas/recomendacoes.html')


@app.route('/processar_recomendacoes', methods=['POST'])
def processar_recomendacoes():
    """Recebe o formulário e chama o modelo para gerar a carteira."""
    try:
        valor = float(request.form['valor'])
        lucro = float(request.form['lucro'])
    except ValueError:
        flash("Por favor, insira valores numéricos válidos.")
        return redirect(url_for('recomendacoes'))

    # 🔹 Chama o modelo para gerar a carteira (risco calculado automaticamente)
    carteira = gerar_carteira(valor, lucro)

    # Caso o modelo retorne erro (ex: banco vazio ou sem solução)
    if "erro" in carteira:
        flash(carteira["erro"])
        return redirect(url_for('recomendacoes'))

    # 🔹 Renderiza a página com o resultado (agora mostrando o risco real)
    return render_template(
        "janelas/carteira_recomendada_resp_mod.html",
        carteira=carteira,
        risco=carteira.get("risco")  # <<< aqui muda de risco_estimado → risco
    )


